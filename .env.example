# Copiar a .env y completar. Nunca commitear .env con claves reales.
# Elegir proveedor: vllm | groq | openai (ver tutorial/00-bienvenida-y-setup.md §0.2)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Elegir proveedor de embeddings: local | openai | gemini | vllm
# (Groq no ofrece un endpoint de embeddings — no es una opción aquí)

# --- local (sentence-transformers) — 100% GRATIS, sin cuenta, sin API key,
# corre en tu máquina (CPU). Instala antes del taller:
#   pip install torch --index-url https://download.pytorch.org/whl/cpu
#   pip install -r requirements.txt
# (el primer `pip install torch` evita que se descargue la build con CUDA,
# varios GB más pesada e innecesaria para este taller) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- OpenAI (de pago desde el primer embedding) ---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# --- Gemini (Google AI Studio) — "gratis" en el papel, pero en la
# práctica algunas cuentas/proyectos de Google Cloud piden activar
# facturación (prepago) incluso dentro del free tier, con un error
# "Your prepayment credits are depleted" al primer embedding. Si te pasa
# eso, usa `local` de arriba en vez de pelear con la facturación. Clave en
# https://aistudio.google.com/apikey ---
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
