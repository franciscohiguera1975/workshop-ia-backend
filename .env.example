# Copiar a .env y completar. Nunca commitear .env con claves reales.
# Elegir proveedor: vllm | groq | openai (ver tutorial/00-bienvenida-y-setup.md §0.2)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Elegir proveedor de embeddings: local | openai | vllm
# (Groq no ofrece un endpoint de embeddings — no es una opción aquí)

# --- local (sentence-transformers) — 100% GRATIS, sin cuenta, sin API
# key, corre en tu máquina (pip install torch --index-url
# https://download.pytorch.org/whl/cpu && pip install -r requirements.txt) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- OpenAI (de pago desde el primer embedding) ---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# Gmail API (herramienta send_email) — ver tutorial/apendice-credenciales.md
# Ruta al token generado por scripts/gmail_auth.py (no se commitea)
GMAIL_TOKEN_PATH=credentials/gmail_token.json
